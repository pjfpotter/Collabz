      "dot": "cyan",
      "title": "The main road",
      "items": [
        "A student opens a page on their phone",
        "The page calls a shared helper",
        "The helper asks Prisma, Prisma asks Neon"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why shared helpers?",
      "items": [
        "Rules like who may connect live in one place",
        "Each team track calls helpers, never another track's insides",
        "So the rules hold even if something calls them directly"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety",
      "items": [
        "No passwords: sign in by emailed magic link",
        "Photos sit in private storage behind a permission check",
        "Pretend cohort never runs in production"
      ]
    }
