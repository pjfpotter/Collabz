# Template for your local .env. Copy it with:  cp .env.example .env
# then fill in the values. Never put real values in THIS file: it is committed.
# Find the URLs in the Neon console: Connect, with the dev branch selected.

# Pooled URL (Connection pooling ON, the host contains "-pooler"). The app uses this.
DATABASE_URL=""

# Direct URL (same as above with "-pooler" removed). Prisma migrations use this.
DIRECT_URL=""

# Database the tests use. Tests EMPTY the tables, so this is separate from
# DATABASE_URL and the tests refuse to run without it. For now it is the same
# pooled dev URL as DATABASE_URL (design decision 8). Never use production.
TEST_DATABASE_URL=""

# Switches on the pretend cohort: the pretend students (`npm run seed:fake`)
# and the "sign in as…" switcher in the nav bar. It must be exactly "on".
# Set it here in your local .env and in Vercel's PREVIEW settings.
# NEVER set it in Vercel's Production settings: the switcher lets anyone
# become any user, including an admin. (As a second lock, the code also
# refuses on the production deployment even if this is set there.)
PRETEND_COHORT=""

# --- Sign-in (slice 1, #8) -------------------------------------------------

# Secret Auth.js uses to protect sign-in tokens and cookies. Make your own with
#   npx auth secret
# Every person and every Vercel environment can have a different one.
AUTH_SECRET=""

# Resend API key, for sending magic-link emails. Create one in the Resend
# dashboard (API Keys). Auth.js reads it from this exact name by itself.
AUTH_RESEND_KEY=""

# Who the magic-link email comes from, e.g. "Collabz <login@ourdomain>".
# It must be on a domain verified in Resend. Until ours is verified, use
# "Collabz <onboarding@resend.dev>": Resend then only delivers to the email
# address that owns the Resend account, which is enough for testing.
EMAIL_FROM=""

# Comma-separated emails that become admins when their account is FIRST
# created, e.g. "patrick@example.com, tom@example.com". Adding someone later
# does nothing; an existing admin promotes them instead (design decision 5).
# Locally you can leave it empty.
ADMIN_EMAILS=""
